{
  "name": "adr-sentinel",
  "version": "1.0.0",
  "description": "Zero-setup sample repository for exercising the ADR Sentinel hook via single-line edits.",
  "type": "commonjs",
  "main": "src/server.js",
  "scripts": {
    "start": "node src/server.js",
    "format": "prettier --write .",
    "adr:guard": "node scripts/adr-guard.js",
    "hooks:install": "git config core.hooksPath .githooks"
  },
  "dependencies": {
    "express": "^4.19.2",
    "pg": "^8.11.5"
  },
  "devDependencies": {
    "prettier": "^3.2.0"
  }
}
